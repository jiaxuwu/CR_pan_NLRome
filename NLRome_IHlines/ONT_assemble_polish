#merge ONT single .fastq files
*.fastq.gz > IH*_raw.fastq.gz
	
#tools for ONT quality control 
##fastqc
parallel -j 6 'fastqc {} -o ./fastqc' ::: IH1_raw.fastq.gz IH2_raw.fastq.gz  IH3_raw.fastq.gz  IH4_raw.fastq.gz  IH5_raw.fastq.gz

##MinIONQC
Rscript MinIONQC.R -i path/to/sequencing_summary.txt

##nanoQC
nanoQC IH*_raw.fastq.gz

##Nanoplot
NanoPlot -t 3 --fastq IH*_raw.fastq.gz --maxlength 40000 --plots dot pauvre kde hex -o ./nanoplot/

#tools for data filter

##NanoFilt
gunzip -c /path/to/IH*_raw.fastq.gz | NanoFilt -q 7 -l 1000 --headcrop 9| gzip > /path/to/IH*_clean_NanoFilt.fastq.gz

#assembler

##flye assembly
module load python/3.7 flye/2.9
flye --nano-raw H1_clean_NanoFilt.fastq.gz -g 930m -o ./assemble/IH* -t 20
 
#Check the assembly quality
## QUAST
module load python/2.7 quast/4.6.1
quast.py -t 10 assembly.fasta -R /path/to/Bnapus_genome/da-ae/GCA_020379485.1_Da-Ae_genomic.fna -G /path/to/Bnapus_genome/da-ae/GCA_020379485.1_Da-Ae_genomic.gff -o ../../quast_result

##CRAQ
perl bin/craq -g /path/to/assemble_flye/IH*/assembly.fasta -sms /path/to/IH*_clean_NanoFilt.fastq.gz -ngs /path/to/renseq_short/data/IH*/9447-JK-7_001_S1_L005_R1.fastq.gz,/path/to/renseq_short/data/IH*/9447-JK-7_001_S1_L005_R2.fastq.gz -x map-ont 

#polish 

##medaka (first-round) 
module load miniconda/3-py3.10 medaka/1.8.0 source activate medaka-1.8.0
medaka_consensus -i path/to/IH*/4.filter/clean.filtlong.fq.gz -d path/to/IH*/6.quast/miniasm.fa -o medaka_output -m r941_min_high -t 10

##hapog (second-round with RenSeq data)
module load python/3.7 bwa/0.7.13 samtools/1.13 hapog/1.2
hapog.py --genome /paht/to/polish_medaka/IH*/consensus_h1.fasta --pe1 /path/to/renseq_short/data/IH*/9447-JK-7_002_S1_L005_R1.fastq.gz --pe2 /path/to/renseq_short/data/IH*/9447-JK-7_002_S1_L005_R2.fastq.gz -o /path/to/polish_hapog/IH* -t 20

##mummer (check the differences after polishing)
module load mummer/3.23
dnadiff  /path/to/assemble_flye/IH*/assembly_IH*.fasta /path/to/hapog_results/hapog_IH*.fasta > dnadiff_IH*.out

#filter sequences longer than 5000bp of the assembly

##biopython

from Bio import SeqIO

def filter_sequences(input_file, output_file, min_length):
    with open(output_file, 'w') as output_handle:
        for record in SeqIO.parse(input_file, 'fasta'):
            if len(record.seq) > min_length:
                SeqIO.write(record, output_handle, 'fasta')

input_fasta = 'hapog_IH*.fasta'
output_fasta = 'IH*_5000_filtered.fasta'
min_length = 5000

filter_sequences(input_fasta, output_fasta, min_length)
