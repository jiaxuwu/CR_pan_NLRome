#merge ONT single .fastq files
*.fastq.gz > H5_raw.fastq.gz
	
#tools for ONT quality control 
##fastqc
parallel -j 6 'fastqc {} -o ./fastqc' ::: H1_raw.fastq.gz H2_raw.fastq.gz  H3_raw.fastq.gz  H4_raw.fastq.gz  H5_raw.fastq.gz  westar_raw.fastq.gz

##MinIONQC
Rscript MinIONQC.R -i path/to/sequencing_summary.txt

##nanoQC
nanoQC wester_raw.fastq.gz

##Nanoplot
NanoPlot -t 3 --fastq westar_raw.fastq.gz --maxlength 40000 --plots dot pauvre kde hex -o ./nanoplot/westar

#tools for data filter

##NanoFilt
gunzip -c /path/to/H1_raw.fastq.gz | NanoFilt -q 7 -l 1000 --headcrop 9| gzip > /path/to/H1_clean_NanoFilt.fastq.gz

#assembler

##flye assembly
module load python/3.7 flye/2.9
flye --nano-raw H1_clean_NanoFilt.fastq.gz -g 930m -o ./assemble/H1 -t 20
 
#Check the assemble quality
## QUAST
module load python/2.7 quast/4.6.1
quast.py -t 10 assembly.fasta -R /home/jiwu08/ABCGfamily/Bnapus_genome/da-ae/GCA_020379485.1_Da-Ae_genomic.fna -G /home/jiwu08/ABCGfamily/Bnapus_genome/da-ae/GCA_020379485.1_Da-Ae_genomic.gff -o ../../quast_result

##CRAQ
perl bin/craq -g /home/jiwu08/longread_canola/raw_data/assemble_flye/H1/assembly.fasta -sms /home/jiwu08/longread_canola/raw_data/H1_clean_NanoFilt.fastq.gz -ngs /home/jiwu08/renseq_short/data/9447-JK-7_001_S1_L005_R1.fastq.gz,/home/jiwu08/renseq_short/data/9447-JK-7_001_S1_L005_R2.fastq.gz -x map-ont 

